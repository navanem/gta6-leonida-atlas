# Optional public URL prefix for static hosting. Defaults to /.
# Build with ATLAS_BASE_PATH=/my-atlas/ pnpm build for a subdirectory.
# ATLAS_BASE_PATH=/

# Optional Google Analytics measurement ID (public identifier, never a server secret).
# Configure the official value in ignored .env.local or your hosting build settings.
# The public default performs no analytics requests. No account/cloud service is enabled.
VITE_ANALYTICS_ID=
# Optional dedicated HTTPS origin for the measurement helper, separate from the app.
VITE_ANALYTICS_ORIGIN=
# Exact HTTPS app origin allowed to initialize that helper.
VITE_ANALYTICS_PARENT_ORIGIN=
