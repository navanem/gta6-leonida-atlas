{
  "name": "gta6-leonida-atlas",
  "version": "0.6.0",
  "private": false,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Standalone local-first community map and optional 3D explorer for Leonida.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navanem/gta6-leonida-atlas.git"
  },
  "bugs": {
    "url": "https://github.com/navanem/gta6-leonida-atlas/issues"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/finalize-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4330",
    "start": "vite preview --host 127.0.0.1 --port 4330",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "build:basemap": "node scripts/build-leonida-atlas-basemap.mjs",
    "test:fork": "node scripts/test-fork.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.5",
    "@fontsource/oswald": "5.2.5",
    "dexie": "4.4.5",
    "leaflet": "1.9.4",
    "lucide-react": "^0.577.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.62.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "22.19.9",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.2",
    "fake-indexeddb": "^6.2.4",
    "prettier": "3.9.6",
    "sharp": "^0.35.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  }
}
