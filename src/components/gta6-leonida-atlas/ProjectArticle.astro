---
import LeonidaAtlasProjectLayout from '@layouts/LeonidaAtlasProjectLayout.astro';
import { buildPageMeta } from '@lib/seo/meta';

interface Props {
  path: string;
  title: string;
  description: string;
  section: string;
}

const { path, title, description, section } = Astro.props;
const meta = buildPageMeta({
  path,
  fallbackTitle: `${title} — GTA6 Leonida Atlas`,
  fallbackDescription: description,
});
---

<LeonidaAtlasProjectLayout {meta}>
  <article class="atlas-article atlas-project-container">
    <header class="atlas-article__header">
      <p class="atlas-section-label">{section}</p>
      <h1>{title}</h1>
      <p>{description}</p>
    </header>
    <div class="atlas-prose"><slot /></div>
  </article>
</LeonidaAtlasProjectLayout>
