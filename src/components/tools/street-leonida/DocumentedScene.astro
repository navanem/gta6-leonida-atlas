---
import type { PublicStreetViewpoint } from '@features/street-leonida/types';
import { authorizedEmbedProvider } from '@features/street-leonida/media';

interface Props {
  viewpoint: PublicStreetViewpoint | null;
}

const { viewpoint } = Astro.props;
const image = viewpoint?.media.image ?? viewpoint?.media.video?.poster ?? null;
const video = viewpoint?.media.video ?? null;
const imageSrcset = image?.variants.map((variant) => `${variant.src} ${variant.width}w`).join(', ');
const sourceLabel = viewpoint?.source.publisher ?? viewpoint?.source.title ?? 'Source';
const embedProvider = authorizedEmbedProvider(video?.embedUrl);
---

<div
  class="street-media"
  data-street-media
  data-media-kind={viewpoint?.media.kind ?? 'unavailable'}
>
  <picture data-street-picture hidden={!image}>
    <img
      data-street-image
      src={image?.src}
      srcset={imageSrcset || undefined}
      sizes="100vw"
      alt={image?.alt ?? ''}
      width={image?.width}
      height={image?.height}
      draggable="false"
      loading="eager"
      decoding="sync"
      fetchpriority="high"
    />
  </picture>

  <video
    data-street-video
    hidden={!video?.src}
    src={video?.src ?? undefined}
    poster={video?.poster?.src ?? undefined}
    preload="metadata"
    playsinline
    aria-label={viewpoint
      ? `Reviewed source excerpt for ${viewpoint.title}`
      : 'Reviewed source excerpt'}
  >
    <track
      data-video-captions
      kind="captions"
      src={video?.captionsUrl ?? undefined}
      srclang="en"
      label="English"
    />
  </video>

  <section
    class="street-embed"
    data-street-embed
    hidden={!video?.embedUrl}
    aria-label="Embedded media"
  >
    <div class="street-embed__prompt" data-embed-prompt>
      <p>
        Authorized embed from <strong data-embed-provider
          >{embedProvider ?? 'approved provider'}</strong
        >
      </p>
      <button type="button" data-load-embed disabled={!embedProvider}>
        Load {embedProvider ?? 'approved'} excerpt
      </button>
      <a
        data-embed-source
        href={viewpoint?.source.url ?? undefined}
        target="_blank"
        rel="noopener noreferrer nofollow"
        hidden={!viewpoint}
      >
        Open documented source
      </a>
    </div>
    <div class="street-embed__host" data-embed-host></div>
  </section>

  <div
    class="street-media__unavailable"
    data-media-unavailable
    hidden={Boolean(image || video?.src || video?.embedUrl)}
  >
    <p>
      {
        viewpoint
          ? 'This documented media is available from its source.'
          : 'Scenes are temporarily unavailable.'
      }
    </p>
    {
      (
        <a
          data-media-outbound
          href={viewpoint?.media.outboundUrl ?? undefined}
          target="_blank"
          rel="noopener noreferrer nofollow"
          hidden={!viewpoint?.media.outboundUrl}
        >
          Open documented media source
        </a>
      )
    }
  </div>

  <div class="street-media__error" data-media-error hidden role="status">
    <strong data-media-error-title>Media unavailable</strong>
    <span>The source and other documented scenes remain available.</span>
    <a
      data-media-error-source
      href={viewpoint?.source.url ?? undefined}
      target="_blank"
      rel="noopener noreferrer nofollow"
      hidden={!viewpoint}
    >
      Open documented source from {sourceLabel}
    </a>
    <button type="button" data-retry-media>Retry media</button>
  </div>
</div>
