---
import WalkableWorld from './WalkableWorld.astro';
import type { PublicStreetPlace, PublicStreetViewpoint } from '@features/street-leonida/types';
import '@styles/street-leonida.css';
import '@styles/leonida-atlas-app.css';

interface Props {
  places: PublicStreetPlace[];
  viewpoints: PublicStreetViewpoint[];
  initialPlace: PublicStreetPlace | null;
  initialViewpoint: PublicStreetViewpoint | null;
  dataUnavailable?: boolean;
  standalone?: boolean;
}

const {
  viewpoints,
  initialPlace,
  initialViewpoint,
  dataUnavailable = false,
  standalone = false,
} = Astro.props;
---

<section
  class="street-shell"
  data-street-shell
  data-atlas-standalone={String(standalone)}
  data-walk-expanded={String(standalone)}
  data-unavailable={String(dataUnavailable)}
>
  <header class="street-shell__bar">
    <a class="street-shell__brand" href="/gta6-leonida-atlas" aria-label="About GTA6 Leonida Atlas">
      <span aria-hidden="true"></span>
      <strong>Leonida Atlas</strong>
    </a>
    <nav class="street-shell__nav" aria-label="Explorer sections">
      <button type="button" data-shell-map><span aria-hidden="true">⌑</span><span>Map</span></button
      >
      <button type="button" data-shell-evidence
        ><span aria-hidden="true">▱</span><span>Evidence</span></button
      >
    </nav>
  </header>

  <WalkableWorld {viewpoints} {initialPlace} {initialViewpoint} {standalone} {dataUnavailable} />

  {
    dataUnavailable && (
      <p class="street-shell__notice" role="status">
        The published scene catalogue is temporarily unavailable. The reconstruction remains clearly
        marked as non-official and does not substitute undocumented detail.
      </p>
    )
  }
</section>

<script>
  const shell = document.querySelector<HTMLElement>('[data-street-shell]');
  const world = shell?.querySelector<HTMLElement>('[data-walk-world]');
  shell?.querySelector<HTMLButtonElement>('[data-shell-map]')?.addEventListener('click', () => {
    world?.querySelector<HTMLButtonElement>('[data-open-walk-map]')?.click();
  });
  shell
    ?.querySelector<HTMLButtonElement>('[data-shell-evidence]')
    ?.addEventListener('click', () => {
      world?.querySelector<HTMLButtonElement>('[data-open-walk-evidence]')?.click();
    });
</script>
