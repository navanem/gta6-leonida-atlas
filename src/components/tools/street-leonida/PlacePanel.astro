---
import type { PublicStreetPlace, PublicStreetViewpoint } from '@features/street-leonida/types';

interface Props {
  place: PublicStreetPlace | null;
  viewpoint: PublicStreetViewpoint | null;
}

const { place, viewpoint } = Astro.props;
const labels = [...new Set([...(place?.labels ?? []), ...(viewpoint?.labels ?? [])])];
---

<dialog class="street-details" data-place-dialog aria-labelledby="street-details-title">
  <div class="street-details__header">
    <div>
      <p>Documented place</p>
      <h2 id="street-details-title" tabindex="-1">Place details</h2>
    </div>
    <button type="button" data-close-details aria-label="Close place details">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="none">
        <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"
        ></path>
      </svg>
    </button>
  </div>

  <div class="street-details__body">
    <div>
      <span class="street-details__label">Place</span>
      <strong data-details-place>{place?.name ?? viewpoint?.place.name ?? 'Unavailable'}</strong>
    </div>
    <div>
      <span class="street-details__label">Documented scene</span>
      <strong data-details-scene>{viewpoint?.title ?? 'No published scene'}</strong>
    </div>
    <p data-details-description>
      {
        place?.description ??
          viewpoint?.visualDescription ??
          'No additional sourced description is published.'
      }
    </p>

    <div>
      <span class="street-details__label">Evidence status</span>
      <ul data-details-labels>
        {labels.map((label) => <li>{label}</li>)}
      </ul>
    </div>

    <div class="street-details__source">
      <span class="street-details__label">Source</span>
      <a
        data-details-source
        href={viewpoint?.source.url ?? place?.source?.url ?? undefined}
        target="_blank"
        rel="noopener noreferrer nofollow"
        hidden={!viewpoint && !place?.source}
      >
        {viewpoint?.source.title ?? place?.source?.title ?? 'Open source'}
      </a>
      <span data-details-source-unavailable hidden={Boolean(viewpoint || place?.source)}>
        No source currently available.
      </span>
    </div>

    <p class="street-details__truth">
      Media, place, position and navigation claims are reviewed independently. An official image
      does not make a map position official.
    </p>
  </div>
</dialog>
