---
import type { PublicStreetPlace, PublicStreetViewpoint } from '@features/street-leonida/types';
import { urls } from '@lib/urls';

interface Props {
  places: PublicStreetPlace[];
  viewpoints: PublicStreetViewpoint[];
  initialSlug: string | null;
}

const { places, viewpoints, initialSlug } = Astro.props;
const placesBySlug = new Map(places.map((place) => [place.slug, place]));
const regions = [
  ...new Map(
    places
      .map((place) => place.region)
      .filter((region): region is NonNullable<PublicStreetPlace['region']> => Boolean(region))
      .map((region) => [region.slug, region]),
  ).values(),
].sort((left, right) => left.name.localeCompare(right.name));
const categories = [
  ...new Map(places.map((place) => [place.category, place.category.replaceAll('_', ' ')] as const)),
].sort((left, right) => left[1].localeCompare(right[1]));
---

<details class="street-navigator" open>
  <summary class="street-navigator__heading">
    <div>
      <strong>Region &amp; scene navigator</strong>
      <p data-position-status>Map position unknown</p>
    </div>
    <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none">
      <path
        d="m4 6 5-2 6 2 5-2v14l-5 2-6-2-5 2V6Z"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linejoin="round"></path>
      <path d="M9 4v14M15 6v14" stroke="currentColor" stroke-width="1.8"></path>
    </svg>
  </summary>

  <div class="street-navigator__body">
    <label class="street-search">
      <span class="sr-only">Search documented scenes</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none">
        <path
          d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14Zm9 2-4-4"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
      <input
        type="search"
        aria-label="Search documented scenes"
        placeholder="Search scenes"
        data-scene-search
      />
    </label>

    <div class="street-navigator__filters">
      <label>
        <span class="sr-only">Filter by region</span>
        <select aria-label="Filter by region" data-scene-filter="region">
          <option value="">All regions</option>
          {regions.map((region) => <option value={region.slug}>{region.name}</option>)}
        </select>
      </label>
      <label>
        <span class="sr-only">Filter by category</span>
        <select aria-label="Filter by category" data-scene-filter="category">
          <option value="">All categories</option>
          {categories.map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
      </label>
      <label>
        <span class="sr-only">Filter by media availability</span>
        <select aria-label="Filter by media availability" data-scene-filter="media">
          <option value="">All media</option>
          <option value="image">Image available</option>
          <option value="video">Direct video available</option>
          <option value="embed">Authorized embed available</option>
          <option value="source">Source link only</option>
        </select>
      </label>
    </div>

    <nav aria-label="Region and scene results">
      <ul class="street-navigator__results" data-scene-results>
        {
          viewpoints.map((viewpoint) => {
            const place = placesBySlug.get(viewpoint.place.slug);
            const searchText = [viewpoint.title, viewpoint.place.name, ...(place?.aliases ?? [])]
              .join(' ')
              .toLocaleLowerCase('en');
            return (
              <li
                data-scene-result
                data-search={searchText}
                data-region={place?.region?.slug ?? ''}
                data-category={place?.category ?? ''}
                data-media={
                  viewpoint.media.image
                    ? 'image'
                    : viewpoint.media.video?.src
                      ? 'video'
                      : viewpoint.media.video?.embedUrl
                        ? 'embed'
                        : 'source'
                }
              >
                <a
                  href={urls.leonidaAtlasViewpoint(viewpoint.slug)}
                  data-scene-slug={viewpoint.slug}
                  data-current-scene-slug={viewpoint.slug}
                  aria-current={viewpoint.slug === initialSlug ? 'page' : undefined}
                >
                  <span>{viewpoint.title}</span>
                  <small>{viewpoint.place.name}</small>
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <p class="street-navigator__empty" data-scene-empty hidden>No documented scenes match.</p>
  </div>
</details>
