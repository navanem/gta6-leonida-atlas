---
import {
  GTADB_LICENSE_URL,
  GTADB_PINNED_DATA_URL,
  GTADB_PREFERRED_SOURCE,
  GTADB_REVISION,
} from '@features/street-leonida/gtadb';
import { PLACE_ENTRY_VIEWS } from '@features/street-leonida/walk-geography';
import type { PublicStreetPlace, PublicStreetViewpoint } from '@features/street-leonida/types';

interface Props {
  viewpoints: PublicStreetViewpoint[];
  initialViewpoint: PublicStreetViewpoint | null;
  initialPlace?: PublicStreetPlace | null;
  standalone?: boolean;
  dataUnavailable?: boolean;
}

const {
  viewpoints,
  initialPlace = null,
  initialViewpoint,
  standalone = false,
  dataUnavailable = false,
} = Astro.props;
const scenes = viewpoints.map((viewpoint) => ({
  slug: viewpoint.slug,
  title: viewpoint.title,
  placeName: viewpoint.place.name,
  placeSlug: viewpoint.place.slug,
  description: viewpoint.visualDescription,
  image: viewpoint.media.image ?? viewpoint.media.video?.poster ?? null,
  source: viewpoint.source,
  labels: viewpoint.labels,
}));
const initialIndex = Math.max(
  0,
  scenes.findIndex((scene) => scene.slug === initialViewpoint?.slug),
);
const initialScene = scenes[initialIndex] ?? null;
const initialPublisher = initialScene?.source.publisher?.trim() || null;
const initialIsRockstarOfficial =
  initialPublisher === 'Rockstar Games' && initialScene?.labels.includes('Official media');
const initialEvidenceLabel = initialIsRockstarOfficial
  ? 'OFFICIAL VISUAL EVIDENCE'
  : 'DOCUMENTED SOURCE EVIDENCE';
const initialProvenance = initialIsRockstarOfficial
  ? 'Rockstar evidence'
  : initialPublisher
    ? `${initialPublisher} evidence`
    : 'Cited-source evidence';
const initialSourceLinkLabel = initialPublisher ? `Open ${initialPublisher}` : 'Open cited source';
const gtadbRevisionLabel = GTADB_REVISION.slice(0, 7);
const regionalDestinations = [
  { slug: 'vice-city', name: 'Vice City', detail: 'Waterfront, beach and urban core' },
  { slug: 'leonida-keys', name: 'Leonida Keys', detail: 'Causeway, islands and marinas' },
  { slug: 'grassrivers', name: 'Grassrivers', detail: 'Wetlands and stilt fish camps' },
  { slug: 'port-gellhorn', name: 'Port Gellhorn', detail: 'Motels and western sprawl' },
  {
    slug: 'ambrosia',
    name: 'Ambrosia',
    detail: 'Allied Crystal Sugar Mill and agricultural context',
  },
  {
    slug: 'mount-kalaga-national-park',
    name: 'Mount Kalaga',
    detail: 'Forest, rock cuts and winding roads',
  },
] as const;
const initialPlaceSlug = initialPlace?.slug ?? initialScene?.placeSlug ?? 'vice-city';
const fallbackEntryView = PLACE_ENTRY_VIEWS[initialPlaceSlug] ?? PLACE_ENTRY_VIEWS['vice-city'];
const fallbackDestination =
  regionalDestinations.find(({ slug }) => slug === initialPlaceSlug) ?? regionalDestinations[0];
---

<section
  class="street-walk"
  data-walk-world
  data-walk-active="false"
  data-walk-ready="false"
  data-player-position={`${fallbackEntryView?.position.x.toFixed(1) ?? '0.0'},${fallbackEntryView?.position.z.toFixed(1) ?? '0.0'}`}
  data-scenes={JSON.stringify(scenes)}
  data-initial-scene={String(initialIndex)}
  data-initial-place={initialPlaceSlug}
  data-atlas-standalone={String(standalone)}
  aria-label="Leonida Atlas community reconstruction"
>
  <canvas
    class="street-walk__canvas"
    data-walk-canvas
    tabindex="-1"
    aria-label="Three-dimensional walkable view of a fan-made Leonida reconstruction"></canvas>
  <div class="street-walk__sky-glow" aria-hidden="true"></div>
  {
    dataUnavailable && (
      <p class="atlas-catalogue-notice" role="status">
        The scene catalogue is temporarily unavailable. The community map remains available;
        selected scene evidence could not be loaded.
      </p>
    )
  }
  <p class="atlas-arrival-notice" data-atlas-arrival-notice role="status" aria-live="polite" hidden>
  </p>

  <div class="street-walk__loading" data-walk-loading role="status">
    <span></span><strong>Building Leonida...</strong>
  </div>

  <div class="street-walk__intro" data-walk-intro hidden={standalone}>
    <span class="street-walk__eyebrow">Evidence-led community reconstruction</span>
    <h2>Walk Leonida</h2>
    <p>
      Explore a continuous 3D interpretation assembled from Rockstar visual evidence and GTADB / Map
      GTA community-estimated coordinates. Interpolated geometry is always presented as
      reconstruction.
    </p>
    <div class="street-walk__key-row" aria-label="Desktop controls">
      <span><kbd>WASD</kbd> Move</span>
      <span><kbd>Mouse</kbd> Look</span>
      <span><kbd>Shift</kbd> Run</span>
      <span><kbd>M</kbd> Map</span>
      <span><kbd>E</kbd> Explore</span>
    </div>
    <button type="button" class="street-walk__start" data-start-walking>
      <span>Enter the reconstruction</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none">
        <path
          d="M8 5h11v14H8M13 9l4 3-4 3M4 12h12"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>

  <button
    type="button"
    class="street-walk__fullscreen-button"
    data-toggle-walk-fullscreen
    aria-label="Open full screen"
    aria-pressed="false"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" width="19" height="19" fill="none">
      <path
        d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"></path>
    </svg>
    <span data-walk-fullscreen-label>Full screen</span>
  </button>

  <div class="street-walk__hud" data-walk-hud>
    <div class="street-walk__location">
      <span data-walk-zone>{fallbackDestination?.name ?? 'Vice City'}</span>
      <small data-walk-zone-detail
        >{fallbackDestination?.detail ?? 'Community reconstruction'}</small
      >
      <small class="street-walk__location-coordinates" data-walk-hud-coordinates
        >GTADB frame · locating…</small
      >
    </div>
    <div class="street-walk__compass" aria-hidden="true">
      <span>W</span><strong data-walk-heading>N</strong><span>E</span>
    </div>
    <div class="street-walk__desktop-legend" aria-label="Movement controls">
      <span><kbd>WASD</kbd> MOVE</span><i></i>
      <button
        type="button"
        data-walk-map-shortcut
        data-open-walk-map
        aria-label="Open complete Leonida map"><kbd>M</kbd> MAP</button
      ><i></i><span><kbd>SHIFT</kbd> RUN</span>
    </div>
    <button
      type="button"
      class="street-walk__map-button"
      data-open-walk-map
      aria-label="Open complete Leonida map"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" width="19" height="19" fill="none">
        <path
          d="m3 6 5-2 8 3 5-2v13l-5 2-8-3-5 2V6Z"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linejoin="round"></path>
        <path d="M8 4v13m8-10v13" stroke="currentColor" stroke-width="1.8"></path>
      </svg>
      <span>Map</span>
    </button>
    <button
      type="button"
      class="street-walk__evidence-button"
      data-open-walk-evidence
      aria-label="Open evidence and source notes"
    >
      <span aria-hidden="true">▱</span><span>Evidence</span>
    </button>
    <div class="street-walk__zoom-controls" aria-label="Camera zoom controls">
      <button type="button" data-walk-zoom-in aria-label="Zoom camera in">+</button>
      <output data-walk-zoom-value aria-live="polite">100%</output>
      <button type="button" data-walk-zoom-out aria-label="Zoom camera out">&minus;</button>
    </div>
    <button
      type="button"
      class="street-walk__exit-button"
      data-stop-walking
      aria-label={standalone ? 'Back to Atlas project' : 'Exit reconstruction'}
      ><span>{standalone ? 'Project' : 'Exit'}</span><kbd>Esc</kbd></button
    >
    <div class="street-walk__minimap" aria-label="Local position locator">
      <span class="street-walk__mini-road street-walk__mini-road--one"></span>
      <span class="street-walk__mini-road street-walk__mini-road--two"></span>
      <span class="street-walk__mini-road street-walk__mini-road--three"></span>
      <span class="street-walk__mini-road street-walk__mini-road--four"></span>
      <span class="street-walk__player-dot" data-walk-player-dot></span>
    </div>
  </div>

  <div class="street-walk__crosshair" data-walk-crosshair aria-hidden="true">
    <span></span><span></span><span></span><span></span>
  </div>
  <button type="button" class="street-walk__prompt" data-walk-prompt hidden
    ><kbd>E</kbd><span>Explore <strong data-walk-prompt-title></strong></span></button
  >
  <p class="street-walk__lock-hint" data-walk-lock-hint hidden>
    Click the street for free-look. Press Esc to release the cursor.
  </p>

  <div
    class="street-walk__mobile-controls"
    data-walk-mobile-controls
    role="group"
    aria-label="Touch controls"
  >
    <div class="street-walk__joystick" data-walk-joystick role="group" aria-label="Analog movement">
      <span data-walk-joystick-knob aria-hidden="true"></span>
      <small aria-hidden="true">MOVE · PUSH TO RUN</small>
    </div>
    <div
      class="street-walk__look-pad"
      data-walk-look-pad
      role="group"
      aria-label="Drag right side to look around"
    >
      <span class="street-walk__pad-center" aria-hidden="true">DRAG TO LOOK</span>
    </div>
    <button type="button" class="street-walk__interact" data-walk-interact disabled>Explore</button>
    <details class="street-walk__button-controls" data-walk-button-controls>
      <summary>Button controls</summary>
      <div class="street-walk__button-controls-panel">
        <div role="group" aria-label="Movement buttons">
          <strong>Move</strong>
          <div>
            <button
              type="button"
              class="street-walk__pad-button"
              data-walk-move-button="forward"
              aria-label="Move forward">↑</button
            >
            <button
              type="button"
              class="street-walk__pad-button"
              data-walk-move-button="left"
              aria-label="Move left">←</button
            >
            <button
              type="button"
              class="street-walk__pad-button"
              data-walk-move-button="backward"
              aria-label="Move backward">↓</button
            >
            <button
              type="button"
              class="street-walk__pad-button"
              data-walk-move-button="right"
              aria-label="Move right">→</button
            >
          </div>
        </div>
        <div role="group" aria-label="Look buttons">
          <strong>Look</strong>
          <div>
            <button
              type="button"
              class="street-walk__pad-button"
              data-walk-look-button="up"
              aria-label="Look up">↑</button
            >
            <button
              type="button"
              class="street-walk__pad-button"
              data-walk-look-button="left"
              aria-label="Look left">←</button
            >
            <button
              type="button"
              class="street-walk__pad-button"
              data-walk-look-button="down"
              aria-label="Look down">↓</button
            >
            <button
              type="button"
              class="street-walk__pad-button"
              data-walk-look-button="right"
              aria-label="Look right">→</button
            >
          </div>
        </div>
      </div>
    </details>
  </div>

  <button
    type="button"
    class="street-walk__credit"
    data-open-walk-evidence
    aria-label="Open source attribution">Sources</button
  >

  <div class="street-walk__unsupported" data-walk-unsupported hidden>
    <strong>3D view unavailable</strong>
    <span
      >Your browser does not support WebGL. The evidence and non-official coordinate map remain
      available.</span
    >
    <button type="button" data-open-walk-map aria-label="Open Leonida atlas">Open atlas</button>
    <button type="button" data-open-walk-evidence>Open evidence notes</button>
  </div>

  <dialog
    class="street-walk-evidence"
    data-walk-evidence-dialog
    aria-labelledby="street-walk-evidence-title"
  >
    <header>
      <div><span>Evidence guide</span><h2 id="street-walk-evidence-title">What is known</h2></div>
      <button type="button" data-close-walk-evidence aria-label="Close evidence notes">×</button>
    </header>
    <div class="street-walk-evidence__body">
      <p class="street-walk-evidence__badge">OFFICIAL VISUALS · COMMUNITY MAP</p>
      <p>
        Rockstar visual evidence can establish official visual identity or existence. GTADB / Map
        GTA supplies community-estimated placement; continuity between evidence points is an
        editorial reconstruction.
      </p>
      <dl>
        <div>
          <dt>CONFIRMED</dt><dd>
            Official visual identity or existence shown or named by Rockstar.
          </dd>
        </div>
        <div>
          <dt>SUPPORTED</dt><dd>Community identification with compatible visual observations.</dd>
        </div>
        <div>
          <dt>APPROXIMATE</dt><dd>Community-estimated placement or reconstructed geometry.</dd>
        </div>
        <div>
          <dt>UNKNOWN</dt><dd>
            Unknown names and source flags such as unconfirmed, may not exist, cancelled, fictional,
            demolished, or duplicate stay marked and hidden by default.
          </dd>
        </div>
      </dl>
      <div class="street-walk-evidence__attribution" aria-label="Full source attribution">
        <p>
          <a
            href="https://www.rockstargames.com/VI/media/screenshots"
            target="_blank"
            rel="noopener noreferrer nofollow">Rockstar visual evidence</a
          > establishes official visual identity or existence only.
        </p>
        <p>
          <a href={GTADB_PREFERRED_SOURCE} target="_blank" rel="noopener noreferrer nofollow"
            >GTADB / Map GTA community reconstruction</a
          > · <a href={GTADB_LICENSE_URL} target="_blank" rel="noopener noreferrer nofollow"
            >CC BY 4.0</a
          > · <a href={GTADB_PINNED_DATA_URL} target="_blank" rel="noopener noreferrer nofollow"
            >pinned revision {gtadbRevisionLabel}</a
          > · transformed presentation; community placement remains approximate and is not an official
          Rockstar map.
        </p>
        <p>original generated material / vegetation studies.</p>
      </div>
    </div>
  </dialog>

  <dialog
    class="street-walk-map atlas-map"
    data-walk-map
    data-atlas-panel-open="false"
    aria-labelledby="street-walk-map-title"
  >
    <div class="street-walk-map__header">
      <a class="atlas-map__brand" href="/gta6-leonida-atlas">
        <span>GTA6 · COMMUNITY CARTOGRAPHY</span>
        <h2 id="street-walk-map-title">Leonida Atlas</h2>
      </a>
      <div class="atlas-map__mode" aria-label="Atlas view">
        <span aria-current="page">Map</span>
        <button type="button" data-close-walk-map aria-label="Explore Leonida in 3D"
          >Explore 3D <span aria-hidden="true">↗</span></button
        >
      </div>
      <button
        class="atlas-map__search-toggle"
        type="button"
        data-atlas-panel-toggle
        aria-expanded="false"
        aria-controls="atlas-destinations"
        aria-label="Search destinations"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"
          ><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.8"
          ></circle><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.8"></path></svg
        >
        <span>Destinations</span>
      </button>
    </div>
    <div class="street-walk-map__body">
      {
        dataUnavailable && (
          <p class="atlas-catalogue-notice" role="status">
            Scene evidence is temporarily unavailable. You can still explore the pinned community
            map. A selected scene may use the default regional arrival.
          </p>
        )
      }
      <p class="atlas-pending-notice" data-atlas-pending-travel role="status" hidden>
        Loading your 3D destination…
      </p>
      <div class="street-walk-map__drawing">
        <div class="street-walk-map__viewport" data-walk-map-viewport>
          <svg
            data-walk-map-svg
            role="group"
            aria-label="Loading the interactive community evidence map"></svg>
        </div>
        <div class="atlas-map__north" aria-hidden="true">
          <span>N</span><svg viewBox="0 0 24 30" width="20" height="26"
            ><path d="m12 1 9 26-9-6-9 6Z" fill="#f2eedf"></path><path
              d="M12 1v20l-9 6Z"
              fill="#73959b"></path></svg
          >
        </div>
        <div class="street-walk-map__toolbar" aria-label="Map zoom controls">
          <button type="button" data-walk-map-zoom-in aria-label="Zoom map in">+</button>
          <output data-walk-map-zoom-value aria-live="polite">100%</output>
          <button type="button" data-walk-map-zoom-out aria-label="Zoom map out">&minus;</button>
          <button type="button" data-walk-map-zoom-reset aria-label="Show all Leonida">Fit</button>
        </div>
        <button
          class="atlas-map__recenter"
          type="button"
          data-walk-map-center-player
          aria-label="Center map on my position"
        >
          <svg viewBox="0 0 24 24" width="23" height="23" fill="none" aria-hidden="true"
            ><circle cx="12" cy="12" r="6" stroke="currentColor" stroke-width="1.7"></circle><circle
              cx="12"
              cy="12"
              r="2"
              fill="currentColor"></circle><path
              d="M12 1v5m0 12v5M1 12h5m12 0h5"
              stroke="currentColor"
              stroke-width="1.7"></path></svg
          >
          <span>My position</span>
        </button>
        <section class="street-walk-map__live" aria-label="Current explorer position">
          <div class="atlas-map__here">
            <i aria-hidden="true"></i><span>You are here</span><strong data-walk-map-live-region
              >{fallbackDestination?.name ?? 'Vice City'}</strong
            >
          </div>
          <div class="atlas-map__heading"><strong data-walk-map-live-heading>N · 000°</strong></div>
          <div class="atlas-map__coordinates">
            <strong data-walk-map-live-gtadb>GTADB locating…</strong>
          </div>
          <div class="atlas-map__world"><strong data-walk-map-live-world>Locating…</strong></div>
          <small data-walk-map-live-evidence>APPROXIMATE · COMMUNITY ESTIMATE</small>
        </section>
        <div class="atlas-map__travel-hint">
          <span aria-hidden="true">↗</span> Tap anywhere to travel <small
            >Drag to pan · scroll or pinch to zoom</small
          >
        </div>
        <div class="street-walk-map__legend" aria-label="Map legend">
          <span><i class="street-walk-map__legend-player"></i>Your position</span>
          <span><i class="street-walk-map__legend-region"></i>Community evidence</span>
          <span class="atlas-map__counts"
            ><b data-walk-gtadb-count>2,198</b> entries · <b data-walk-gtadb-rendered-count>2,091</b
            > positioned · <b data-walk-gtadb-unpositioned-count>107</b> unpositioned</span
          >
        </div>
      </div>
      <aside
        id="atlas-destinations"
        class="street-walk-map__destinations"
        aria-label="Leonida map navigation"
      >
        <div class="atlas-map__panel-heading">
          <div>
            <span class="street-walk-map__panel-kicker">Explore the evidence</span><strong
              class="street-walk-map__destination-title">Find a destination</strong
            >
          </div><button type="button" data-atlas-panel-close aria-label="Close destinations"
            >×</button
          >
        </div>
        <p class="street-walk-map__fallback-note" data-walk-map-fallback-note role="status" hidden>
          3D travel is unavailable in this browser. You can still pan, zoom and browse the evidence
          catalogue.
        </p>
        <label class="street-walk-map__search"
          ><span>Search the GTADB catalogue</span><input
            type="search"
            data-walk-map-search
            aria-label="Search GTADB places"
            placeholder="Place, tag or marker ID…"
            autocomplete="off"
            spellcheck="false"
          /></label
        >
        <details class="street-walk-map__quick" open>
          <summary>Six regions <span>APPROXIMATE</span></summary>
          <div class="street-walk-map__list">
            {
              regionalDestinations.map((destination, index) => (
                <button type="button" data-walk-region={destination.slug}>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <strong>{destination.name}</strong>
                  <small>{destination.detail}</small>
                  <em aria-hidden="true">↗</em>
                </button>
              ))
            }
          </div>
        </details>
        <div class="street-walk-map__layers" aria-label="Map layers">
          <button
            type="button"
            data-walk-map-layer-toggle="supported"
            aria-pressed="true"
            aria-label="Hide GTADB entries without uncertainty signals"
            ><span data-walk-map-toggle-state>Hide</span><strong>Named evidence</strong><small
              >No listed uncertainty signals</small
            ></button
          >
          <button
            type="button"
            data-walk-map-layer-toggle="uncertain"
            aria-pressed="false"
            aria-label="Show uncertain GTADB entries"
            ><span data-walk-map-toggle-state>Show</span><strong>Uncertain entries</strong><small
              >Unknown name or source-flagged</small
            ></button
          >
        </div>
        <div class="street-walk-map__results-header">
          <output data-walk-map-search-summary aria-live="polite">Loading catalogue…</output><button
            type="button"
            data-walk-map-search-clear
            hidden>Clear</button
          >
        </div>
        <div
          class="street-walk-map__results"
          data-walk-map-search-results
          aria-label="GTADB search results"
          aria-busy="true"
        >
          <p class="street-walk-map__results-empty">Loading the pinned local snapshot…</p>
        </div>
        <p class="street-walk-map__caveat" data-walk-map-caveat>
          Community-estimated positions. Source-derived coastlines, roads and land cover are
          APPROXIMATE. Unmapped areas and unknown names remain UNKNOWN.
        </p>
        <a class="atlas-map__evidence-link" href="/gta6-leonida-atlas/credits"
          >Sources, credits & methodology <span aria-hidden="true">↗</span></a
        >
      </aside>
    </div>
    <footer>
      <span><strong>APPROXIMATE</strong> · Not an official Rockstar map</span>
      <span
        ><a href={GTADB_PREFERRED_SOURCE} target="_blank" rel="noopener noreferrer"
          >GTADB / Map GTA</a
        > · <a href={GTADB_LICENSE_URL} target="_blank" rel="noopener noreferrer">CC BY 4.0</a> · <a
          href={GTADB_PINNED_DATA_URL}
          target="_blank"
          rel="noopener noreferrer">{gtadbRevisionLabel}</a
        > · recolored & generalized</span
      >
    </footer>
  </dialog>

  <dialog
    class="street-walk-scene"
    data-walk-scene-dialog
    aria-labelledby="street-walk-scene-title"
  >
    <button
      type="button"
      class="street-walk-scene__close"
      data-close-walk-scene
      aria-label="Close discovery">&times;</button
    >
    <div class="street-walk-scene__media">
      <img
        data-walk-scene-image
        src={initialScene?.image?.src}
        alt={initialScene?.image?.alt ?? ''}
        hidden={!initialScene?.image?.src}
        loading="lazy"
      />
      <span data-walk-scene-evidence-label>{initialEvidenceLabel}</span>
    </div>
    <div class="street-walk-scene__content">
      <span
        ><span data-walk-scene-provenance>{initialProvenance}</span> · <b data-walk-scene-place
          >{initialScene?.placeName ?? 'Leonida'}</b
        ></span
      >
      <h2 id="street-walk-scene-title" data-walk-scene-title>
        {initialScene?.title ?? 'Documented scene'}
      </h2>
      <p data-walk-scene-description>{initialScene?.description}</p>
      <p class="street-walk-scene__note">
        The source is documented; its nearby hotspot placement and interpolated geometry remain
        approximate unless a cited position says otherwise.
      </p>
      <div class="street-walk-scene__actions">
        <a
          data-walk-scene-page
          href={initialScene
            ? `/gta6-leonida-atlas/app/viewpoint/${initialScene.slug}`
            : '/gta6-leonida-atlas/credits'}>Read evidence notes</a
        >
        <a
          data-walk-scene-source
          href={initialScene?.source.url ?? '#'}
          target="_blank"
          rel="noopener noreferrer nofollow">{initialSourceLinkLabel}</a
        >
      </div>
    </div>
  </dialog>
</section>

<script>
  import { initializeWalkWorldOverlays } from '@features/street-leonida/walk-overlays';

  document.querySelectorAll<HTMLElement>('[data-walk-world]').forEach((world) => {
    const overlays = initializeWalkWorldOverlays(world);
    let controller: { dispose(): void } | undefined;
    let disposed = false;
    let enterWhenReady = false;
    let pendingMapTravel: unknown = null;
    let idleDelay: number | undefined;
    let idleCallback: number | undefined;
    let runtimePromise: Promise<void> | null = null;
    const bootstrapEvents = new AbortController();
    const startButton = world.querySelector<HTMLButtonElement>('[data-start-walking]');
    const mapDialog = world.querySelector<HTMLDialogElement>('[data-walk-map]');
    const panelToggle = world.querySelector<HTMLButtonElement>('[data-atlas-panel-toggle]');
    const panelClose = world.querySelector<HTMLButtonElement>('[data-atlas-panel-close]');
    const pendingNotice = world.querySelector<HTMLElement>('[data-atlas-pending-travel]');
    const setPanelOpen = (open: boolean): void => {
      if (!mapDialog) return;
      mapDialog.dataset.atlasPanelOpen = String(open);
      panelToggle?.setAttribute('aria-expanded', String(open));
      if (open)
        world
          .querySelector<HTMLInputElement>('[data-walk-map-search]')
          ?.focus({ preventScroll: true });
      else panelToggle?.focus({ preventScroll: true });
    };
    panelToggle?.addEventListener(
      'click',
      () => setPanelOpen(mapDialog?.dataset.atlasPanelOpen !== 'true'),
      { signal: bootstrapEvents.signal },
    );
    panelClose?.addEventListener('click', () => setPanelOpen(false), {
      signal: bootstrapEvents.signal,
    });
    mapDialog?.addEventListener(
      'cancel',
      (event) => {
        if (mapDialog.dataset.atlasPanelOpen !== 'true') return;
        event.preventDefault();
        setPanelOpen(false);
      },
      { signal: bootstrapEvents.signal },
    );
    const cancelScheduledLoad = (): void => {
      if (idleDelay !== undefined) window.clearTimeout(idleDelay);
      if (idleCallback !== undefined && typeof window.cancelIdleCallback === 'function') {
        window.cancelIdleCallback(idleCallback);
      }
      idleDelay = undefined;
      idleCallback = undefined;
    };

    const requestRuntimeLoad = (): void => {
      if (disposed || runtimePromise) return;
      cancelScheduledLoad();
      world.dataset.walkRuntime = 'loading';
      runtimePromise = import('@features/street-leonida/walk-world')
        .then(({ initializeWalkableWorld }) => {
          if (disposed) return;
          controller = initializeWalkableWorld(world, overlays);
          world.dataset.walkRuntime = controller ? 'ready' : 'unavailable';
          if (!controller) {
            pendingMapTravel = null;
            pendingNotice?.setAttribute('hidden', '');
          }
          if (pendingMapTravel && controller) {
            const detail = pendingMapTravel;
            pendingMapTravel = null;
            pendingNotice?.setAttribute('hidden', '');
            mapDialog?.dispatchEvent(
              new CustomEvent('street-leonida:map-travel', { detail, bubbles: true }),
            );
          }
          if (enterWhenReady && controller) {
            enterWhenReady = false;
            queueMicrotask(() => startButton?.click());
          }
        })
        .catch(() => {
          if (disposed) return;
          world.dataset.walkRuntime = 'unavailable';
          pendingMapTravel = null;
          pendingNotice?.setAttribute('hidden', '');
          overlays.showWebglFallback();
        });
    };

    const requestEntry = (event: MouseEvent): void => {
      if (controller || disposed) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      enterWhenReady = true;
      requestRuntimeLoad();
    };

    mapDialog?.addEventListener(
      'street-leonida:map-travel',
      (event) => {
        if (controller || disposed || world.dataset.walkMode === 'atlas-only') return;
        event.preventDefault();
        event.stopImmediatePropagation();
        pendingMapTravel = (event as CustomEvent<unknown>).detail;
        pendingNotice?.removeAttribute('hidden');
        requestRuntimeLoad();
      },
      { capture: true, signal: bootstrapEvents.signal },
    );

    startButton?.addEventListener('pointerenter', requestRuntimeLoad, {
      once: true,
      signal: bootstrapEvents.signal,
    });
    startButton?.addEventListener('focus', requestRuntimeLoad, {
      once: true,
      signal: bootstrapEvents.signal,
    });
    startButton?.addEventListener('pointerdown', requestRuntimeLoad, {
      once: true,
      signal: bootstrapEvents.signal,
    });
    startButton?.addEventListener('click', requestEntry, {
      capture: true,
      signal: bootstrapEvents.signal,
    });

    world.dataset.walkRuntime = 'deferred';
    idleDelay = window.setTimeout(() => {
      idleDelay = undefined;
      if (typeof window.requestIdleCallback === 'function') {
        idleCallback = window.requestIdleCallback(requestRuntimeLoad, { timeout: 900 });
      } else {
        requestRuntimeLoad();
      }
    }, 180);
    document.addEventListener(
      'astro:before-swap',
      () => {
        disposed = true;
        cancelScheduledLoad();
        bootstrapEvents.abort();
        controller?.dispose();
        overlays.dispose();
      },
      { once: true },
    );
  });
</script>
