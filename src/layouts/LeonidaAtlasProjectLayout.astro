---
import SeoHead from '@components/seo/SeoHead.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import GoogleTag from '@components/analytics/GoogleTag.astro';
import type { PageMeta } from '@lib/seo/meta';
import { organizationSchema, websiteSchema } from '@lib/seo/schema-org';
import { urls } from '@lib/urls';
import '@styles/global.css';
import '@styles/leonida-atlas.css';

interface Props {
  meta: PageMeta;
}

const { meta } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const navigation = [
  { label: 'Atlas', href: urls.leonidaAtlas() },
  { label: 'About', href: urls.leonidaAtlasAbout() },
  { label: 'Documentation', href: urls.leonidaAtlasDocumentation() },
  { label: 'Credits', href: urls.leonidaAtlasCredits() },
];
const footerGroups = [
  {
    title: 'Project',
    links: [
      { label: 'About', href: urls.leonidaAtlasAbout() },
      { label: 'Documentation', href: urls.leonidaAtlasDocumentation() },
      { label: 'Credits & sources', href: urls.leonidaAtlasCredits() },
    ],
  },
  {
    title: 'Participate',
    links: [
      { label: 'Contributing', href: urls.leonidaAtlasContributing() },
      { label: 'Changelog', href: urls.leonidaAtlasChangelog() },
      { label: 'Licenses', href: urls.leonidaAtlasLicenses() },
    ],
  },
];
---

<html lang="en" class="atlas-project-document">
  <head>
    <meta charset="utf-8" />
    <GoogleTag />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SeoHead {meta} />
    <JsonLd schema={websiteSchema()} />
    <JsonLd schema={organizationSchema()} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="atlas-project">
    <a class="atlas-skip-link" href="#main-content">Skip to content</a>
    <header class="atlas-project-header">
      <div class="atlas-project-container atlas-project-header__inner">
        <a class="atlas-wordmark" href={urls.leonidaAtlas()}>GTA6 Leonida Atlas</a>
        <nav class="atlas-project-nav" aria-label="Leonida Atlas">
          {
            navigation.map((item) => (
              <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <a class="atlas-button atlas-button--small" href={urls.leonidaAtlasApp()}>
          Open atlas <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="atlas-project-footer">
      <div class="atlas-project-container atlas-project-footer__grid">
        <div class="atlas-project-footer__intro">
          <a class="atlas-wordmark" href={urls.leonidaAtlas()}>GTA6 Leonida Atlas</a>
          <p>
            An independent cartography project. Not affiliated with Rockstar Games or Take-Two
            Interactive.
          </p>
        </div>
        {
          footerGroups.map((group) => (
            <nav aria-label={group.title}>
              <strong>{group.title}</strong>
              {group.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </nav>
          ))
        }
        <div class="atlas-project-footer__status">
          <strong>Project status</strong>
          <p>Public source release and its code license are in preparation.</p>
          <a href={urls.home()}>Return to GTA6State</a>
        </div>
      </div>
    </footer>
  </body>
</html>
