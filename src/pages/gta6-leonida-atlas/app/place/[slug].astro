---
import ExplorerShell from '@components/tools/street-leonida/ExplorerShell.astro';
import { loadAtlasPageData } from '@features/street-leonida/page-data';
import LeonidaAtlasAppLayout from '@layouts/LeonidaAtlasAppLayout.astro';
import { buildPageMeta } from '@lib/seo/meta';
import { urls } from '@lib/urls';

export const prerender = false;

const slug = Astro.params.slug as string;
const data = await loadAtlasPageData({ kind: 'place', slug });
if (!data.dataUnavailable && !data.focusFound) return Astro.redirect('/404');
const name = data.initialPlace?.name ?? 'Leonida location';
const meta = buildPageMeta({
  path: urls.leonidaAtlasPlace(slug),
  fallbackTitle: `${name} — GTA6 Leonida Atlas`,
  fallbackDescription:
    data.initialPlace?.description ??
    `Explore the evidence and approximate community placement associated with ${name}.`,
  fallbackImage: data.initialViewpoint?.media.image?.src ?? null,
});
---

<LeonidaAtlasAppLayout {meta}>
  <ExplorerShell
    places={data.places}
    viewpoints={data.viewpoints}
    initialPlace={data.initialPlace}
    initialViewpoint={data.initialViewpoint}
    dataUnavailable={data.dataUnavailable}
    standalone
  />
</LeonidaAtlasAppLayout>
