---
import ProjectArticle from '@components/gta6-leonida-atlas/ProjectArticle.astro';
import { LEONIDA_ATLAS_RELEASES } from '@features/street-leonida/releases';
import { urls } from '@lib/urls';
---

<ProjectArticle
  path={urls.leonidaAtlasChangelog()}
  title="Changelog"
  section="Project record"
  description="A concise record of public-facing changes to the atlas and its evidence model."
>
  {
    LEONIDA_ATLAS_RELEASES.map((release) => (
      <section class="atlas-release">
        <p>
          <time datetime={release.date}>
            {new Date(`${release.date}T00:00:00Z`).toLocaleDateString('en-GB', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
              timeZone: 'UTC',
            })}
          </time>{' '}
          · {release.version} · {release.status === 'public' ? 'Public site release' : 'In preparation'}
        </p>
        <h2>{release.title}</h2>
        <p>{release.summary}</p>
        <h3>Shipped</h3>
        <ul>
          {release.highlights.map((highlight) => (
            <li>{highlight}</li>
          ))}
        </ul>
        <h3>Verification</h3>
        <ul>
          {release.verification.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    ))
  }
  <section>
    <h2>Release status</h2>
    <p>
      The public source release remains in preparation, so these are website releases rather than
      GitHub releases. Future entries will continue to describe shipped changes rather than an
      uncommitted roadmap.
    </p>
  </section>
</ProjectArticle>
