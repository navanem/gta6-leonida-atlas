{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "noEmit": true,
    "allowJs": true, "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "esModuleInterop": true, "skipLibCheck": true, "verbatimModuleSyntax": true,
    "types": ["vite/client", "node"], "baseUrl": ".",
    "paths": { "@/*": ["src/*"], "@features/*": ["src/features/*"], "@lib/*": ["src/lib/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "*.config.ts"],
  "exclude": ["dist", "node_modules"]
}
